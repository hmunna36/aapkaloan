# Where enquiry / consultation leads are delivered.
# Any endpoint that accepts a JSON POST works: Zapier / Make / n8n webhook,
# Zoho CRM / HubSpot / LeadSquared web-to-lead endpoint, or your own backend.
# If unset, leads are printed to the server log (fine for local development).
LEAD_WEBHOOK_URL=

# Optional shared secret sent as the "x-webhook-secret" header with each lead.
LEAD_WEBHOOK_SECRET=

# Public site URL, used for canonical URLs, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.aapkaloan.com
