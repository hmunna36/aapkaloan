# --- Where enquiries go ------------------------------------------------------
# Email and webhook can be used together; an enquiry counts as delivered if at
# least one of them accepts it. With neither set, enquiries are only printed to
# the server log (fine for local development, NOT for production).
#
# Email: each enquiry is emailed to LEAD_EMAIL_TO. aapkaloan.com's mail is on
# GoDaddy and its SPF record only lets GoDaddy send as @aapkaloan.com, so send
# through GoDaddy's own SMTP, logged in as the info@ mailbox. On Vercel, set
# these with scripts/setup-lead-email.sh — it asks for the password with hidden
# typing and stores it as a sensitive variable.
SMTP_HOST=smtpout.secureserver.net
# 465 = SSL (default); 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=info@aapkaloan.com
SMTP_PASS=
# One address, or several separated by commas
LEAD_EMAIL_TO=info@aapkaloan.com
# Optional; defaults to "AapKaLoan Website <SMTP_USER>"
LEAD_EMAIL_FROM=

# Webhook: any endpoint that accepts a JSON POST — Zapier / Make / n8n, a Zoho CRM /
# HubSpot / LeadSquared web-to-lead endpoint, or your own backend.
LEAD_WEBHOOK_URL=

# Optional shared secret sent as the "x-webhook-secret" header with each lead.
LEAD_WEBHOOK_SECRET=

# Public site URL, used for canonical URLs, sitemap and social cards.
# With or without the scheme ("https://" is added if missing). If it's blank or
# missing, the site falls back to Vercel's deployment URL, then to the production
# domain below.
NEXT_PUBLIC_SITE_URL=https://www.aapkaloan.com

# --- Credit bureau (CIBIL) score check -------------------------------------
# Which provider serves the live check:
#   off   (default) live check disabled; the site shows the enquiry form instead
#   mock            sample data for demos, clearly labelled in the UI
#   http            a real bureau/aggregator via src/lib/cibil/providers/http.ts
# See docs/CIBIL-INTEGRATION.md before switching this on.
CIBIL_PROVIDER=off
# Must mirror CIBIL_PROVIDER so the browser knows whether to show the form:
# "off", "mock" or "live".
NEXT_PUBLIC_CIBIL_MODE=off

# Only needed when CIBIL_PROVIDER=http
CIBIL_API_BASE_URL=
CIBIL_API_KEY=
CIBIL_API_CLIENT_ID=
CIBIL_BUREAU_NAME=CIBIL

# Salt for hashing PAN/IP in rate-limit and audit records. Set to a long random
# string in production; rotating it resets rate-limit counters.
CIBIL_HASH_SALT=
